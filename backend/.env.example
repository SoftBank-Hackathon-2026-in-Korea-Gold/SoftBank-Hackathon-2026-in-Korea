# =============================================================================
# CloudMorph Environment Variables Example (.env.example)
# 복사하여 .env 파일로 사용: cp .env.example .env (주의: .env는 절대 git 커밋 금지)
# =============================================================================

# -----------------------------------------------------------------------------
# 1. AI & LLM 설정 — 아래 셋 중 아무거나 채우면 동작합니다
# -----------------------------------------------------------------------------
#   제공자                         채울 값                                     HEALER 기본 모델
#   1) Claude API                  ANTHROPIC_API_KEY                          claude-haiku-5-5
#   2) OpenAI API                  OPENAI_API_KEY                             gpt-4o
#   3) 로컬 서빙(vLLM / SGLang /    OPENAI_BASE_URL=http://<host>:<port>/v1    (없음 → HEALER_MODEL에
#      Ollama / llama.cpp 등)       (키 불필요, 필요하면 OPENAI_API_KEY)         서빙 중인 모델명 필수)
#
# healer: 여러 개가 채워져 있으면 Claude → OpenAI → 로컬 순서로 시도하고, 실패하면 다음으로 넘어갑니다.
#         LLM_PROVIDER로 하나를 고정할 수 있습니다 (anthropic | openai | local | vllm | sglang | ollama | llamacpp).
#         LLM_PROVIDER=ollama이고 OPENAI_BASE_URL이 비어 있으면 http://localhost:11434/v1을 씁니다.
# analyzer: Claude(ANTHROPIC_API_KEY), Jev(TYPESAFE_API_KEY), 로컬 clef-flash(CLEF_BASE_URL) 중 하나가 필요합니다
#           (Jev·clef-flash는 아래 빠른 분석, 담당: 이요환).

# 1) Claude API
ANTHROPIC_API_KEY=

# 2) OpenAI API
OPENAI_API_KEY=

# 3) 로컬 / OpenAI 호환 서버
# OPENAI_BASE_URL=http://localhost:8000/v1

# 선택: 제공자 고정
# LLM_PROVIDER=

# healer 모델. 비우면 제공자 기본값. 다른 제공자용 이름(예: Claude 키인데 gpt-4o)이면 무시하고 기본값을 씁니다.
# 제공자별로 따로 두려면 HEALER_MODEL_ANTHROPIC / HEALER_MODEL_OPENAI / HEALER_MODEL_LOCAL
# HEALER_MODEL=

# analyzer 모델 (Claude, 기본값: claude-haiku-5-5). 더 정확하게: claude-sonnet-5-5, claude-opus-5-5
ANALYZER_MODEL=claude-haiku-5-5

# analyzer 동시 LLM 호출 제한 및 에이전트 루프 최대 턴 수 (선택)
# ANALYZER_MAX_LLM_CALLS=6
# ANALYZER_MAX_TURNS=15

# Optional metadata-only Langfuse tracing: uv sync --project backend --extra tracing
# Keys alone do not enable it. Prompts, source, stderr, env values and user/repo names are never exported.
LANGFUSE_TRACING_ENABLED=false
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# LANGFUSE_BASE_URL=https://cloud.langfuse.com

# Verified healing memory; disabled by default so demos still show the healing loop.
CLOUDMORPH_HEAL_MEMORY=0
# CLOUDMORPH_HEAL_MEMORY_FILE=.cloudmorph/heal-memory.sqlite3
# CLOUDMORPH_HEAL_MEMORY_DAYS=30

# 빠른 분석: Jev나 로컬 clef-flash가 1초 안에 서비스를 고르고, 분석 전체를 몇 초에 끝냅니다 (docs/analyzer.md)
# 아래 TYPESAFE_API_KEY(Jev)가 있으면 Jev를 먼저 씁니다. 없으면 scripts/clef-up.sh가 켜고 알려 주는 주소의 clef-flash.
# 둘 다 비우면 Claude 검사관만 씁니다.
# CLEF_BASE_URL=http://127.0.0.1:11436
# CLEF_MODEL=clef-flash
# ANALYZER_MODE=auto        # auto: Jev나 clef-flash가 있으면 빠른 분석 · fast: 빠른 분석만 · full: Claude 검사관만

# Jev: 빠른 분석과 장애 대응(떠 있는 앱을 몇 초마다 확인하고 원인과 조치를 고름, docs/incident.md)이 같이 씁니다.
# Jev 키가 없으면 로컬 clef-flash(CLEF_BASE_URL)가 같은 API로 대신 판단합니다.
# TYPESAFE_API_KEY=
# JEV_MODEL=jev-latest
# CLOUDMORPH_GUARD=1        # 0이면 감시하지 않습니다
# GUARD_INTERVAL=3          # 확인 간격(초)

# -----------------------------------------------------------------------------
# 2. Google Cloud Platform (GCP) 및 Cloud Run 배포 설정
# -----------------------------------------------------------------------------
# Cloud Run 배포 시 필수: GCP 프로젝트 ID (예: bdai-n8n-2609161021)
GCP_PROJECT_ID=

# Cloud Run 및 Artifact Registry 대상 리전 (기본값: asia-northeast3)
GCP_REGION=asia-northeast3

# Artifact Registry Docker 저장소 이름 (기본값: hackathon)
GCP_AR_REPO=hackathon

# -----------------------------------------------------------------------------
# 3. 배포 에이전트 (deployer) 세부 설정 (Optional)
# -----------------------------------------------------------------------------
# Cloud Run 서비스 이름 (미설정 시 기본값: 배포 대상 src_dir 폴더명)
# DEPLOYER_SERVICE_NAME=

# 로컬(Docker) 배포 시 cloudflared quick tunnel 공개 URL 발급 여부 (기본값: 1, CI 시: 0)
# DEPLOYER_TUNNEL=1

# 컨테이너 헬스체크 HTTP 경로 (기본값: /health)
# DEPLOYER_HEALTH_PATH=/health

# Cloud Run HTTP startup probe 검사 경로 (미설정 시 기본 TCP 프로브 동작)
# DEPLOYER_PROBE_PATH=/health

# 배포 후 헬스체크 검증 대기 타임아웃(초) (기본값: 60)
# DEPLOYER_VERIFY_TIMEOUT=60

# -----------------------------------------------------------------------------
# 4. 백엔드 오케스트레이터 서버 설정 (FastAPI / Uvicorn, Optional)
# -----------------------------------------------------------------------------
# PORT=8000
# HOST=0.0.0.0
# CORS_ORIGINS=http://localhost:5173
