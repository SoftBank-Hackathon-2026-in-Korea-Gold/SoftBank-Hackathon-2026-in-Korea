# Copy to .env (never commit .env)
OPENAI_API_KEY=
HEALER_MODEL=gpt-4o

GCP_PROJECT_ID=
GCP_REGION=asia-northeast3
GCP_AR_REPO=hackathon

# deployer (optional)
# DEPLOYER_TUNNEL=0            # local 배포 시 cloudflared 비활성화 (CI)
# DEPLOYER_HEALTH_PATH=/health
# DEPLOYER_PROBE_PATH=/health  # 설정 시 Cloud Run HTTP 기동 검사. 기본은 TCP
# DEPLOYER_VERIFY_TIMEOUT=60
# DEPLOYER_SERVICE_NAME=       # Cloud Run 서비스 이름 (기본: src_dir 이름)
